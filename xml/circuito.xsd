<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.uniovi.es"
           xmlns="http://www.uniovi.es"
           elementFormDefault="qualified">	

    <xs:element name="circuito">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="nombre" />
                <xs:element ref="longitudCircuito" />
                <xs:element ref="anchura" />
                <xs:element ref="fecha" />
                <xs:element ref="hora" />
                <xs:element ref="vueltas" />
                <xs:element ref="localidad" />
                <xs:element ref="pais" />
                <xs:element ref="referencias" />
                <xs:element ref="fotografias" />
                <xs:element ref="videos" />
                <xs:element ref="coordenadas" />
                <xs:element ref="tramos" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="nombre" type="xs:string" />
    <xs:element name="valor" type="xs:integer" />
    <xs:element name="unidad" type="xs:string" />
    
    <xs:element name="longitudCircuito">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="valor" />
                <xs:element ref="unidad" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="anchura">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="valor" />
                <xs:element ref="unidad" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="fecha" type="xs:date" />
    <xs:element name="hora" type="xs:time" />
    <xs:element name="vueltas" type="xs:integer" />
    <xs:element name="localidad" type="xs:string" />
    <xs:element name="pais" type="xs:string" />
    
    <xs:element name="referencias">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="3" maxOccurs="unbounded" ref="referencia" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="referencia" type="xs:string" />
    
    <xs:element name="fotografias">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="1" maxOccurs="5" ref="fotografia" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="fotografia">
        <xs:complexType>
            <xs:attribute name="archivo" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>
    
    <xs:element name="videos">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="3" ref="video" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="video">
        <xs:complexType>
            <xs:attribute name="archivo" type="xs:string" use="required" />
        </xs:complexType>
    </xs:element>
    
    <xs:element name="coordenadas">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="latitud" />
                <xs:element ref="longitud" />
                <xs:element ref="altitud" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    
    <xs:element name="latitud" type="xs:decimal" />
    <xs:element name="longitud" type="xs:decimal" />
    <xs:element name="altitud" type="xs:integer" />
    
    <xs:element name="tramos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="tramo" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element ref="latitud" />
                            <xs:element ref="longitud" />
                            <xs:element ref="altitud" />
                        </xs:sequence>
                        <xs:attribute name="distancia" type="xs:decimal" use="required" />
                        <xs:attribute name="unidades" type="xs:string" use="required" />
                        <xs:attribute name="sector" type="xs:string" use="required" />
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
  
</xs:schema>
